# Copy to .env (used by `npm run dev` and docker compose). Never commit .env.
DATABASE_URL=postgres://witness:witness@localhost:5432/witness
# Ed25519 key that signs checkpoints. Create one with: npm run witness -- keygen
WITNESS_SIGNING_KEY=
# Protects the operator endpoints (/admin). At least 32 characters.
WITNESS_ADMIN_TOKEN=
WITNESS_CHECKPOINT_INTERVAL_SECONDS=300
